    "test:newsletter": "node --test tests/newsletterIntegration.test.mjs",
    "test:reviews": "node --test tests/reviewsIntegration.test.mjs",
    "test:admin-categories": "node --test tests/adminCategoryContract.test.mjs",
    "test:admin-collections": "node --test tests/adminCollectionContract.test.mjs",
    "test:admin-media": "node --test tests/adminMediaContract.test.mjs",
    "test:admin-products": "node --test tests/adminProductContract.test.mjs",
