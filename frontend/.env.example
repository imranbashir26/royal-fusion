# Every VITE_ value is public and visible in the browser bundle.
# Never place passwords, service-role keys, write tokens, or API secrets here.
VITE_API_URL=replace_with_public_api_base_url
VITE_SUPABASE_URL=replace_with_public_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_public_supabase_publishable_key
VITE_SANITY_PROJECT_ID=replace_with_public_sanity_project_id
VITE_SANITY_DATASET=replace_with_public_sanity_dataset
VITE_SANITY_API_VERSION=replace_with_public_sanity_api_version

# Build-time public blog integration; only the exact value true enables it.
VITE_ENABLE_SANITY_BLOGS=false
# Required when enabled: approved exact HTTPS storefront origin, never a guessed domain.
VITE_BLOG_CANONICAL_ORIGIN=
