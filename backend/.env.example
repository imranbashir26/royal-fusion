NODE_ENV=replace_with_environment_name
PORT=replace_with_backend_port
CLIENT_ORIGIN=replace_with_allowed_frontend_origin

# SERVER-ONLY SECRETS. Never expose these through VITE_ variables.
AUTH_CSRF_SECRET=replace_with_separate_strong_random_secret

# Development-only prototype administrator. Production ignores these values.
JWT_SECRET=replace_with_strong_random_secret
ADMIN_EMAIL=replace_with_initial_owner_email
ADMIN_PASSWORD=replace_with_initial_owner_password
ADMIN_NAME=replace_with_initial_owner_name

# Server-controlled authentication providers and security gates.
CUSTOMER_AUTH_PROVIDER=replace_with_prototype_or_supabase
ADMIN_AUTH_PROVIDER=replace_with_prototype_or_supabase
ENABLE_GUEST_ORDER_LINKING=replace_with_true_or_false
ENABLE_ADMIN_MFA=replace_with_true_or_false
AUTH_SECURE_COOKIES=replace_with_true_or_false
AUTH_TRUST_PROXY=replace_with_true_or_false
AUTH_ALLOW_DEV_LOOPBACK=replace_with_true_or_false
AUTH_CALLBACK_URL=replace_with_backend_verification_callback_url

# Protected session durations in seconds.
CUSTOMER_SESSION_IDLE_SECONDS=replace_with_customer_idle_seconds
CUSTOMER_SESSION_ABSOLUTE_SECONDS=replace_with_customer_absolute_seconds
ADMIN_SESSION_IDLE_SECONDS=replace_with_admin_idle_seconds
ADMIN_SESSION_ABSOLUTE_SECONDS=replace_with_admin_absolute_seconds
AUTH_ACCESS_COOKIE_SECONDS=replace_with_access_cookie_seconds
AUTH_REFRESH_WINDOW_SECONDS=replace_with_near_expiry_refresh_window_seconds
AUTH_REFRESH_LEASE_SECONDS=replace_with_refresh_lease_seconds
AUTH_RECENT_AUTH_SECONDS=replace_with_recent_authentication_seconds
AUTH_RECOVERY_SESSION_SECONDS=replace_with_recovery_session_seconds
AUTH_VERIFICATION_STATE_SECONDS=replace_with_verification_state_seconds

# Database connectivity is independent from the authentication providers.
USE_SUPABASE=replace_with_true_or_false
SUPABASE_URL=replace_with_server_supabase_url
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
SANITY_API_TOKEN=replace_with_sanity_server_token

# Optional server integrations.
SENTRY_DSN=replace_with_server_monitoring_dsn
RESEND_API_KEY=replace_with_server_email_api_key

# Optional prototype database override. Keep the live JSON database backend-only.
RF_DB_PATH=replace_with_backend_database_file_path
