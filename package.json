{
  "name": "royal-fusion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.20.0 || ^24.0.0"
  },
  "workspaces": [
    "frontend",
    "backend",
    "sanity"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "preview": "npm run preview --workspace frontend",
    "admin:create": "npm run admin:create --workspace backend --",
    "api:smoke": "npm run api:smoke --workspace backend",
    "env:check:prod": "npm run env:check:prod --workspace backend",
    "test:backend": "npm test --workspace backend",
    "test:auth": "npm run test:auth-contracts --workspace backend",
    "test:guest-checkout": "npm run test:guest-checkout --workspace backend",
    "test:auth-foundation": "npm run test:backend",
    "test:sql-auth-schema": "npm run test:sql-auth-schema --workspace backend",
    "test:auth-sessions": "npm run test:auth-sessions --workspace backend",
    "test:sql-auth-sessions": "npm run test:sql-auth-sessions --workspace backend",
    "dev:studio": "npm run dev --workspace @royal-fusion/studio",
    "build:studio": "npm run build --workspace @royal-fusion/studio",
    "test:studio": "npm test --workspace @royal-fusion/studio",
    "typecheck:studio": "npm run typecheck --workspace @royal-fusion/studio"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
